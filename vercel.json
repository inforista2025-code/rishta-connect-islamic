{
  "functions": {
    "api/send-daily-newsletter.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily-newsletter",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
