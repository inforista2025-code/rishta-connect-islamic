{
  "functions": {
    "api/send-daily-newsletter.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily-newsletter",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/profiles",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/og-profiles"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
