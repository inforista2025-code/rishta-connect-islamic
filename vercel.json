{
  "functions": {
    "api/send-daily-newsletter.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily-newsletter",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/profiles",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Slackbot|Discordbot|Applebot|iMessage|Pinterestbot|Instagram|meta-externalagent|meta-externalfetcher|Snapchat|vkShare).*"
        }
      ],
      "destination": "/api/og-profiles"
    },
    {
      "source": "/profiles/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Slackbot|Discordbot|Applebot|iMessage|Pinterestbot|Instagram|meta-externalagent|meta-externalfetcher|Snapchat|vkShare).*"
        }
      ],
      "destination": "/api/og-profiles?id=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
